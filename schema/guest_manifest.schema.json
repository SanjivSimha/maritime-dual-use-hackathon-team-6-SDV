{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by `python -m tools.guest_schema` from shipos.contracts.GuestManifest; do not edit. Validates a resolved card: raw YAML strings \"$<id>\" are replaced with values from data/assumptions/ (shipos.data.resolve) first.",
  "$defs": {
    "Activity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "duration_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Min"
        },
        "preempt": {
          "items": {
            "$ref": "#/$defs/PreemptOption"
          },
          "title": "Preempt",
          "type": "array"
        },
        "followed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Followed By"
        }
      },
      "required": [
        "name",
        "mode"
      ],
      "title": "Activity",
      "type": "object"
    },
    "AtSeaSwap": {
      "additionalProperties": false,
      "properties": {
        "what": {
          "title": "What",
          "type": "string"
        },
        "via": {
          "enum": [
            "flight_deck",
            "ramp"
          ],
          "title": "Via",
          "type": "string"
        },
        "people": {
          "title": "People",
          "type": "integer"
        },
        "minutes": {
          "title": "Minutes",
          "type": "number"
        }
      },
      "required": [
        "what",
        "via",
        "people",
        "minutes"
      ],
      "title": "AtSeaSwap",
      "type": "object"
    },
    "Battery": {
      "additionalProperties": false,
      "properties": {
        "endurance_min": {
          "title": "Endurance Min",
          "type": "number"
        },
        "critical_pct": {
          "title": "Critical Pct",
          "type": "number"
        },
        "land_within_min": {
          "title": "Land Within Min",
          "type": "number"
        },
        "on_deny": {
          "const": "ditch",
          "default": "ditch",
          "title": "On Deny",
          "type": "string"
        }
      },
      "required": [
        "endurance_min",
        "critical_pct",
        "land_within_min"
      ],
      "title": "Battery",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value_by_mission": {
          "additionalProperties": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "type": "string"
          },
          "title": "Value By Mission",
          "type": "object"
        },
        "default": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "type": "string",
          "default": "low",
          "title": "Default"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "name",
        "value_by_mission"
      ],
      "title": "Capability",
      "type": "object"
    },
    "ComputeDemand": {
      "additionalProperties": false,
      "properties": {
        "cores": {
          "default": 0,
          "title": "Cores",
          "type": "number"
        },
        "mem_gb": {
          "default": 0,
          "title": "Mem Gb",
          "type": "number"
        },
        "accelerators": {
          "default": 0,
          "title": "Accelerators",
          "type": "integer"
        }
      },
      "title": "ComputeDemand",
      "type": "object"
    },
    "Conditions": {
      "additionalProperties": false,
      "description": "Ship state a guest activity needs. None = no requirement on that variable.",
      "properties": {
        "speed_kn": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "course": {
          "anyOf": [
            {
              "$ref": "#/$defs/Course"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "noise": {
          "anyOf": [
            {
              "$ref": "#/$defs/Noise"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deck": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeckState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "emission": {
          "anyOf": [
            {
              "$ref": "#/$defs/Emission"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deck_machinery_allowed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deck Machinery Allowed"
        },
        "wind_max_kn": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wind Max Kn"
        },
        "sea_state_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sea State Max"
        },
        "uses_flight_deck": {
          "default": false,
          "title": "Uses Flight Deck",
          "type": "boolean"
        },
        "uses_ramp": {
          "default": false,
          "title": "Uses Ramp",
          "type": "boolean"
        },
        "needs_manoeuvre_freedom": {
          "default": false,
          "title": "Needs Manoeuvre Freedom",
          "type": "boolean"
        }
      },
      "title": "Conditions",
      "type": "object"
    },
    "CoolingKind": {
      "enum": [
        "water",
        "air"
      ],
      "title": "CoolingKind",
      "type": "string"
    },
    "Course": {
      "enum": [
        "free",
        "steady"
      ],
      "title": "Course",
      "type": "string"
    },
    "DeckState": {
      "enum": [
        "clear",
        "occupied"
      ],
      "title": "DeckState",
      "type": "string"
    },
    "Emission": {
      "enum": [
        "normal",
        "silent"
      ],
      "title": "Emission",
      "type": "string"
    },
    "Exclusion": {
      "additionalProperties": false,
      "description": "excludes: absolute \u2192 refusal at admission; conditional \u2192 modes cannot coincide.",
      "properties": {
        "kind": {
          "enum": [
            "absolute",
            "conditional"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "target_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Mode"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "reason"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "Installation": {
      "additionalProperties": false,
      "properties": {
        "where": {
          "enum": [
            "port_only",
            "at_sea_window",
            "logical"
          ],
          "title": "Where",
          "type": "string"
        },
        "people": {
          "title": "People",
          "type": "integer"
        },
        "hours": {
          "title": "Hours",
          "type": "number"
        }
      },
      "required": [
        "where",
        "people",
        "hours"
      ],
      "title": "Installation",
      "type": "object"
    },
    "Link": {
      "enum": [
        "backbone",
        "satcom",
        "radio",
        "acoustic"
      ],
      "title": "Link",
      "type": "string"
    },
    "LinkDemand": {
      "additionalProperties": false,
      "properties": {
        "link": {
          "$ref": "#/$defs/Link"
        },
        "mbps": {
          "title": "Mbps",
          "type": "number"
        },
        "elastic": {
          "default": true,
          "title": "Elastic",
          "type": "boolean"
        }
      },
      "required": [
        "link",
        "mbps"
      ],
      "title": "LinkDemand",
      "type": "object"
    },
    "Mode": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/ModeTier",
          "default": "normal"
        },
        "power_kw": {
          "title": "Power Kw",
          "type": "number"
        },
        "duration_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Min"
        },
        "next_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Mode"
        },
        "interruptible": {
          "default": true,
          "title": "Interruptible",
          "type": "boolean"
        },
        "deferrable": {
          "default": false,
          "title": "Deferrable",
          "type": "boolean"
        },
        "capability_factor": {
          "default": 1.0,
          "title": "Capability Factor",
          "type": "number"
        },
        "peak_kw": {
          "default": 0.0,
          "title": "Peak Kw",
          "type": "number"
        },
        "peak_s": {
          "default": 0.0,
          "title": "Peak S",
          "type": "number"
        },
        "deck_machinery": {
          "default": false,
          "title": "Deck Machinery",
          "type": "boolean"
        },
        "conditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Conditions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "power_kw"
      ],
      "title": "Mode",
      "type": "object"
    },
    "ModeTier": {
      "description": "Shedding ladder, cheapest first: throttle (low_power) before standby before off.",
      "enum": [
        "normal",
        "low_power",
        "standby",
        "off"
      ],
      "title": "ModeTier",
      "type": "string"
    },
    "Noise": {
      "enum": [
        "quiet",
        "normal",
        "manoeuvring"
      ],
      "title": "Noise",
      "type": "string"
    },
    "Part": {
      "additionalProperties": false,
      "description": "part-of: admitted and shed with its parent; placed separately only if `allowed` is set.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "mass_t": {
          "title": "Mass T",
          "type": "number"
        },
        "area_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area M2"
        },
        "height_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height M"
        },
        "allowed": {
          "items": {
            "$ref": "#/$defs/SlotKind"
          },
          "title": "Allowed",
          "type": "array"
        },
        "preferred": {
          "items": {
            "$ref": "#/$defs/SlotKind"
          },
          "title": "Preferred",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "mass_t"
      ],
      "title": "Part",
      "type": "object"
    },
    "PreemptOption": {
      "additionalProperties": false,
      "description": "How an activity can yield to another guest (D3).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "hold_mode": {
          "title": "Hold Mode",
          "type": "string"
        },
        "window_min": {
          "title": "Window Min",
          "type": "number"
        },
        "rerun": {
          "title": "Rerun",
          "type": "boolean"
        },
        "resume_delay_min": {
          "default": 0.0,
          "title": "Resume Delay Min",
          "type": "number"
        }
      },
      "required": [
        "name",
        "hold_mode",
        "window_min",
        "rerun"
      ],
      "title": "PreemptOption",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "description": "Closed interval; a missing bound is open.",
      "properties": {
        "lo": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lo"
        },
        "hi": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hi"
        }
      },
      "title": "Range",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "target",
        "reason"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "SafetyCommands": {
      "additionalProperties": false,
      "properties": {
        "link": {
          "$ref": "#/$defs/Link"
        },
        "autonomous_fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autonomous Fallback"
        }
      },
      "required": [
        "link"
      ],
      "title": "SafetyCommands",
      "type": "object"
    },
    "SlotKind": {
      "enum": [
        "bay1_whole",
        "bay1_half",
        "bay2",
        "mast",
        "hangar",
        "hangar_roof"
      ],
      "title": "SlotKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "mass_t": {
      "title": "Mass T",
      "type": "number"
    },
    "area_m2": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Area M2"
    },
    "cooling": {
      "$ref": "#/$defs/CoolingKind"
    },
    "preferred": {
      "items": {
        "$ref": "#/$defs/SlotKind"
      },
      "title": "Preferred",
      "type": "array"
    },
    "allowed": {
      "items": {
        "$ref": "#/$defs/SlotKind"
      },
      "title": "Allowed",
      "type": "array"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/Part"
      },
      "title": "Parts",
      "type": "array"
    },
    "modes": {
      "items": {
        "$ref": "#/$defs/Mode"
      },
      "title": "Modes",
      "type": "array"
    },
    "initial_mode": {
      "title": "Initial Mode",
      "type": "string"
    },
    "activities": {
      "items": {
        "$ref": "#/$defs/Activity"
      },
      "title": "Activities",
      "type": "array"
    },
    "data": {
      "items": {
        "$ref": "#/$defs/LinkDemand"
      },
      "title": "Data",
      "type": "array"
    },
    "compute": {
      "$ref": "#/$defs/ComputeDemand",
      "default": {
        "cores": 0.0,
        "mem_gb": 0.0,
        "accelerators": 0
      }
    },
    "excludes": {
      "items": {
        "$ref": "#/$defs/Exclusion"
      },
      "title": "Excludes",
      "type": "array"
    },
    "requires": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requires",
      "type": "array"
    },
    "safety_critical": {
      "default": false,
      "title": "Safety Critical",
      "type": "boolean"
    },
    "capability": {
      "$ref": "#/$defs/Capability"
    },
    "installation": {
      "$ref": "#/$defs/Installation"
    },
    "at_sea_swap": {
      "anyOf": [
        {
          "$ref": "#/$defs/AtSeaSwap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "logical_reconfig": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logical Reconfig"
    },
    "battery": {
      "anyOf": [
        {
          "$ref": "#/$defs/Battery"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "safety_commands": {
      "anyOf": [
        {
          "$ref": "#/$defs/SafetyCommands"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "radar_sensitivity_loss": {
      "default": 0.0,
      "title": "Radar Sensitivity Loss",
      "type": "number"
    }
  },
  "required": [
    "id",
    "name",
    "mass_t",
    "cooling",
    "preferred",
    "allowed",
    "modes",
    "initial_mode",
    "capability",
    "installation"
  ],
  "title": "GuestManifest",
  "type": "object"
}
